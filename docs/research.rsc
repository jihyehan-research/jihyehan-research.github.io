1:["$","section",null,{"id":"research","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Research"}],["$","h1",null,{"children":"Research Questions"}]]}],["$","div",null,{"className":"research-details","children":[["$","article",null,{"children":[["$","div",null,{"className":"research-label","children":[["$","span",null,{"className":"number","children":"01"}],["$","h3",null,{"children":"Pharmaceutical Regulation"}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"How do regulators like the US FDA balance regulatory flexibility with rigorous evidentiary standards for innovative new drugs?"}],["$","p",null,{"children":"Early access to innovative medicines such as first-in-class drugs can benefit patients with life-threatening conditions; however, these drugs may carry clinical uncertainty when approved on the basis of incomplete clinical evidence or surrogate endpoints."}],["$","p",null,{"children":"I study how the regulators can balance regulatory flexibility with rigorous assessment of the evidence supporting pharmaceutical innovation, ensuring the clinical benefit of drugs in routine clinical use."}],["$","p",null,{"className":"keywords","children":[["$","strong",null,{"children":"Keywords:"}]," first-in-class drug, accelerated approval, rare disease treatment"]}]]}]]}],["$","article",null,{"children":[["$","div",null,{"className":"research-label","children":[["$","span",null,{"className":"number","children":"02"}],["$","h3",null,{"children":"Medication Access & Affordability"}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"How can pharmaceutical pricing and reimbursement policies ensure affordable and sustainable prescription drug coverage?"}],["$","p",null,{"children":"Pharmacy benefit design—situated within a complex insurance structure that, in the US, is segmented across private insurance and public programs—determines patient access to prescription drugs."}],["$","p",null,{"children":"I study the mechanisms that promote or thwart effective market competition, along with the factors that shape medication access and affordability. I analyze a wide variety of relevant datasets, including commercial claims, Medicare drug formularies, and Center for Medicare and Medicaid (CMS) spending data."}],["$","p",null,{"className":"keywords","children":[["$","strong",null,{"children":"Keywords:"}]," claim data analysis, pharmacy benefit design, pharmacoepidemiology"]}]]}]]}],["$","article",null,{"children":[["$","div",null,{"className":"research-label","children":[["$","span",null,{"className":"number","children":"03"}],["$","h3",null,{"children":"Health Decision Science"}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"How can policymakers allocate limited resources to maximize societal benefit and equitable access to high-value care?"}],["$","p",null,{"children":"From a health system perspective, resources are limited, and every policy decision carries trade-offs. In particular, as new technologies accelerate to address unmet medical needs and health care spending rises with costly new medicines, our ability to prioritize equitable access to high-value care is at stake."}],["$","p",null,{"children":"I study the evidence that informs policymakers about the expected downstream effects of their decisions on patients, as well as optimization methods that can deliver the greatest societal benefit."}],["$","p",null,{"className":"keywords","children":[["$","strong",null,{"children":"Keywords:"}]," pharmacoeconomics, health decision modeling, cost-effectiveness analysis"]}]]}]]}]]}]]}]
