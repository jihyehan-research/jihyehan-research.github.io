1:[["$","a",null,{"className":"skip","href":"#main","children":"Skip to content"}],["$","header",null,{"children":[["$","a",null,{"className":"wordmark","href":"#main","children":["Jihye Han",["$","span",null,{"children":"PharmD, MPH"}]]}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"#research","children":"Research"}],["$","a",null,{"href":"#publications","children":"Publications"}],["$","a",null,{"href":"#media","children":"Media Coverage"}],["$","a",null,{"href":"#cv","children":"CV"}]]}]]}],["$","main",null,{"id":"main","children":[["$","section",null,{"className":"intro","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Pharmaceutical Policy Research"}],["$","h1",null,{"children":["Jihye Han",["$","span",null,{"children":"PharmD, MPH"}]]}],["$","p",null,{"className":"lead","children":"Studying how policy design can be optimized to ensure safe, affordable, and equitable access to prescription drugs while supporting timely pharmaceutical innovation."}],["$","div",null,{"className":"links","children":[["$","a",null,{"className":"button","href":"#publications","children":["Explore publications ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"./Jihye-Han-CV.pdf","children":["View CV (PDF) ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"social-links","aria-label":"Contact and professional profiles","children":[["$","a",null,{"className":"social-button","href":"mailto:jihye.han@vanderbilt.edu","children":"Contact ↗"}],["$","a",null,{"className":"social-button","href":"https://scholar.google.com/citations?user=hSbNRuQAAAAJ&hl=en","children":"Google Scholar ↗"}],["$","a",null,{"className":"social-button","href":"https://www.linkedin.com/in/jihye-han-b55725191/","children":"LinkedIn ↗"}]]}]]}],["$","aside",null,{"className":"profile","children":[["$","img",null,{"className":"headshot","src":"./jihye-han.jpg","alt":"Jihye Han","width":"1461","height":"1461"}],["$","span",null,{"className":"eyebrow","children":"About me"}],["$","p",null,{"children":"I am a PhD student in Health Policy at Vanderbilt University."}],["$","p",null,{"children":"I hold a PharmD from Chung-Ang University in South Korea and an MPH in Health Policy from the Harvard T.H. Chan School of Public Health."}],["$","p",null,{"children":"Previously, I worked with PORTAL at Brigham and Women’s Hospital and Harvard Medical School, following experience in regulatory affairs at GSK Seoul office."}],["$","a",null,{"href":"mailto:jihye.han@vanderbilt.edu","children":["Get in touch ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","section",null,{"id":"research","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"01 / Research"}],["$","h2",null,{"children":"Research Questions"}]]}],["$","div",null,{"className":"research-details","children":[["$","article",null,{"children":[["$","div",null,{"className":"research-label","children":[["$","span",null,{"className":"number","children":"01"}],["$","h3",null,{"children":"Pharmaceutical Regulation"}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"How do regulators like the US FDA balance regulatory flexibility with rigorous evidentiary standards for innovative new drugs?"}],["$","p",null,{"children":"Early access to innovative medicines such as first-in-class drugs can benefit patients with life-threatening conditions; however, these drugs may carry clinical uncertainty when approved on the basis of incomplete clinical evidence or surrogate endpoints."}],["$","p",null,{"children":"I study how the regulators can balance regulatory flexibility with rigorous assessment of the evidence supporting pharmaceutical innovation, ensuring the clinical benefit of drugs in routine clinical use."}],["$","p",null,{"className":"keywords","children":[["$","strong",null,{"children":"Keywords:"}]," first-in-class drug, accelerated approval, rare disease treatment"]}]]}]]}],["$","article",null,{"children":[["$","div",null,{"className":"research-label","children":[["$","span",null,{"className":"number","children":"02"}],["$","h3",null,{"children":"Medication Access & Affordability"}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"How can pharmaceutical pricing and reimbursement policies ensure affordable and sustainable prescription drug coverage?"}],"$Ld","$Le","$Lf"]}]]}],"$L10"]}]]}],"$L11","$L12","$L13"]}],"$L14"]
d:["$","p",null,{"children":"Pharmacy benefit design—situated within a complex insurance structure that, in the US, is segmented across private insurance and public programs—determines patient access to prescription drugs."}]
e:["$","p",null,{"children":"I study the mechanisms that promote or thwart effective market competition, along with the factors that shape medication access and affordability. I analyze a wide variety of relevant datasets, including commercial claims, Medicare drug formularies, and Center for Medicare and Medicaid (CMS) spending data."}]
f:["$","p",null,{"className":"keywords","children":[["$","strong",null,{"children":"Keywords:"}]," claim data analysis, pharmacy benefit design, pharmacoepidemiology"]}]
10:["$","article",null,{"children":[["$","div",null,{"className":"research-label","children":[["$","span",null,{"className":"number","children":"03"}],["$","h3",null,{"children":"Health Decision Science"}]]}],["$","div",null,{"children":[["$","h4",null,{"children":"How can policymakers allocate limited resources to maximize societal benefit and equitable access to high-value care?"}],["$","p",null,{"children":"From a health system perspective, resources are limited, and every policy decision carries trade-offs. In particular, as new technologies accelerate to address unmet medical needs and health care spending rises with costly new medicines, our ability to prioritize equitable access to high-value care is at stake."}],["$","p",null,{"children":"I study the evidence that informs policymakers about the expected downstream effects of their decisions on patients, as well as optimization methods that can deliver the greatest societal benefit."}],["$","p",null,{"className":"keywords","children":[["$","strong",null,{"children":"Keywords:"}]," pharmacoeconomics, health decision modeling, cost-effectiveness analysis"]}]]}]]}]
